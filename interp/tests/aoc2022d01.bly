-- AoC 2022 day 1: the elf carrying the most calories, and the top three together.

func keep(top: long[], sum: long)          -- top is kept sorted, smallest first
  if sum > top[0] then
    top[0] = sum
    top.sort()
  end
end

func main()
  var top: long[3]
  var sum: long = 0
  for line in lines() do
    if line == "" then
      keep(top, sum)
      sum = 0
    else
      sum += line.int()
    end
  end
  keep(top, sum)                           -- the last elf has no blank line after it
  print "Part 1: "; top[2]
  print "Part 2: "; top[0] + top[1] + top[2]
end
