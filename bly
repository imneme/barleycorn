#!/usr/bin/env python3
"""Barleycorn's front door: run a program in the interpreter, or compile it
and run it.

The tools it uses (a C compiler, sjasmplus, tnylpo, omse-ai) are found as
paths.py says. Each run builds in a folder of its own under build/bly, so
runs at the same time don't collide.

What the keyboard types (for ask(), key() and inkey()) comes on stdin: from
the terminal as you type, for run, c and cpm; zx and all take it from a file
or a pipe, and the 48K has it typed for it (zxrun.py --keys).
"""
import argparse
import os
import shutil
import subprocess
import sys
import tempfile

ROOT = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, ROOT)
import paths                                                # noqa: E402


def reads_keys(prog):
    """does the program call ask(), inkey() or key()? (If it doesn't parse, the build will say why.)"""
    sys.path.insert(0, os.path.join(ROOT, 'interp'))
    import barley
    barley.EMBED_DIR = os.path.dirname(os.path.abspath(prog))      # where its includes are
    try:
        return barley.uses_keys(barley.Parser(open(prog).read()).program())
    except barley.BarleyError:
        return False


def asks_only(prog):
    """does the program read keys only through ask(), never key() or inkey()? Then each line typed for the 48K can
    wait for its question, however long the program works before asking (zxrun.py --wait-ask)"""
    sys.path.insert(0, os.path.join(ROOT, 'interp'))
    import barley
    barley.EMBED_DIR = os.path.dirname(os.path.abspath(prog))
    try:
        d = barley.Parser(open(prog).read()).program()
    except barley.BarleyError:
        return False
    return barley.uses_keys(d, ('ask',)) and not barley.uses_keys(d, ('inkey', 'key'))


def typed_keys():
    """the keys on stdin for zx and all, which need them before the program runs: a file's, whole; a pipe's, as
    much as has come and keeps coming without a pause (so a pipe nobody writes to or closes, a tool harness's,
    say, gives none, rather than waiting for ever); a terminal's, none"""
    import select
    import stat
    if sys.stdin is None or sys.stdin.isatty():
        return None
    fd = sys.stdin.fileno()
    if stat.S_ISREG(os.fstat(fd).st_mode):
        return sys.stdin.buffer.read().decode('latin-1')
    data = b''
    while select.select([fd], [], [], 0.5)[0]:
        chunk = os.read(fd, 65536)
        if not chunk:
            break
        data += chunk
    return data.decode('latin-1') if data else None


def typed(keys):
    """subprocess.run's stdin: the keys, or the terminal's own when there are none"""
    return {} if keys is None else {'input': keys.encode('latin-1')}


def run_c(prog, inp, work, capture=False, keys=None, out=None, wrap=False):
    """out: build the executable there, to keep, and don't run it. wrap: integer overflow wraps (BLY_WRAP)"""
    stem = os.path.splitext(os.path.basename(prog))[0]
    c, exe = os.path.join(work, stem + '.c'), out or os.path.join(work, stem)
    g = subprocess.run([sys.executable, os.path.join(ROOT, 'c', 'cgen.py'), prog], capture_output=True, text=True)
    if g.returncode:
        return g.returncode, (g.stdout + g.stderr)
    open(c, 'w').write(g.stdout)
    cc = paths.need(paths.CC, 'a C compiler', 'set CC (paths.py)')
    b = subprocess.run([cc, '-std=c11', '-O3'] + (['-DBLY_WRAP'] if wrap else []) +
                       ['-I', os.path.join(ROOT, 'c', 'rt'), c, '-lm', '-o', exe])
    if b.returncode or out:
        return b.returncode, ''
    r = subprocess.run([exe] + inp, capture_output=capture, **typed(keys))
    return r.returncode, (r.stdout.decode('latin-1') if capture else '')


def run_cpm(prog, inp, work, capture=False, keys=None, unchecked=False):
    stem = os.path.splitext(os.path.basename(prog))[0]
    name = ''.join(ch for ch in stem.lower() if ch.isalnum())[:8] or 'prog'   # a CP/M name: 8 letters or digits
    asm, com = os.path.join(work, stem + '.asm'), os.path.join(work, name + '.com')
    g = subprocess.run([sys.executable, os.path.join(ROOT, 'z80', 'z80gen.py'), prog] +
                       (['--unchecked'] if unchecked else []), capture_output=True, text=True)
    if g.returncode:
        return g.returncode, (g.stdout + g.stderr)
    open(asm, 'w').write(g.stdout)
    sj = paths.need(paths.SJASMPLUS, 'sjasmplus', 'set SJASMPLUS (paths.py)')
    a = subprocess.run([sj, '--nologo', f'--raw={com}', asm], capture_output=True, text=True)
    if a.returncode:
        return a.returncode, a.stdout + a.stderr
    tn = paths.need(paths.TNYLPO, 'tnylpo', 'set TNYLPO (paths.py)')
    args = []
    if inp:
        shutil.copy(inp[0], os.path.join(work, 'input.txt'))
        args = ['input.txt']
    conf = os.path.join(work, 'tnylpo.conf')
    open(conf, 'w').write(f'drive a = "{work}"\ndefault drive = a\n')
    r = subprocess.run([tn, '-f', conf, name] + args, capture_output=capture, **typed(keys))
    return r.returncode, (r.stdout.decode('latin-1') if capture else '')


def make_tap(prog, inp, tap, plain=False, unchecked=False):
    t = subprocess.run([sys.executable, os.path.join(ROOT, 'z80', 'zxbuild.py'), prog] + inp + ['-o', tap] +
                       (['--plain'] if plain else []) + (['--unchecked'] if unchecked else []),
                       capture_output=True, text=True)
    sys.stderr.write(t.stdout + t.stderr)                   # the build's report isn't the program's output
    return t.returncode


def run_zx(tap, scr, minutes, capture=False, keys=None, wait_ask=False):
    paths.omse_ai()
    cmd = [paths.OMSE_AI_PYTHON, os.path.join(ROOT, 'z80', 'zxrun.py'), tap, '--minutes', str(minutes)] + \
        (['--scr', scr] if scr else []) + (['--wait-ask'] if wait_ask else [])
    if keys is not None:
        kf = os.path.splitext(tap)[0] + '.keys'
        open(kf, 'w', encoding='latin-1').write(keys)
        cmd += ['--keys', kf]
    r = subprocess.run(cmd, capture_output=capture, text=capture, encoding='latin-1' if capture else None)
    return r.returncode, (r.stdout if capture else '')


def upper(a):
    """the upper 22 rows of a .scr: what BASIC's report at the end doesn't touch"""
    return a >= 6144 and (a - 6144) // 32 < 22 or a < 6144 and (((a >> 8) & 0x18) | ((a >> 5) & 7)) < 22


def run_all(prog, inp, work, minutes, keys):
    """keys: the same keys typed for each (none: an empty stdin, not the terminal's)"""
    keys = keys or ''
    r = subprocess.run([sys.executable, os.path.join(ROOT, 'interp', 'barley.py'), '--check', prog],
                       capture_output=True, text=True, stdin=subprocess.DEVNULL)
    if r.returncode:
        sys.stdout.write(r.stdout + r.stderr)
        print('  nothing ran: the program doesn\'t compile')
        return 1
    outs, codes = {}, {}
    png = os.path.join(work, 'interp.png')
    r = subprocess.run([sys.executable, os.path.join(ROOT, 'interp', 'barley.py'), '--screen', png, prog] + inp,
                       capture_output=True, **typed(keys))
    outs['interp'], codes['interp'] = r.stdout.decode('latin-1'), r.returncode
    r = subprocess.run([sys.executable, os.path.join(ROOT, 'interp', 'barley.py'), '--as', 'cpm', prog] + inp,
                       capture_output=True, **typed(keys))
    outs['interp-cpm'] = r.stdout.decode('latin-1')        # what CP/M must print: ZX is false there, CPM true
    codes['c'], outs['c'] = run_c(prog, inp, work, capture=True, keys=keys)
    codes['cpm'], outs['cpm'] = run_cpm(prog, inp, work, capture=True, keys=keys)
    tap, zscr = os.path.join(work, 'prog.tap'), os.path.join(work, 'zx.scr')
    if make_tap(prog, inp, tap) == 0:
        codes['zx'], outs['zx'] = run_zx(tap, zscr, minutes, capture=True, keys=keys,
                                         wait_ask=bool(keys) and asks_only(prog))
    else:
        codes['zx'], outs['zx'] = 1, '(the tape failed to build)'
    sys.stdout.flush()
    sys.stdout.buffer.write(outs['interp'].encode('latin-1'))     # the bytes it printed, as they were
    sys.stdout.flush()
    ok = True
    sys.path.insert(0, os.path.join(ROOT, 'interp', 'tests'))
    from run import floats_agree                # the suite's: a float may differ by 1e-7 of itself, and in spelling
    tolerated = False
    for k in ('c', 'cpm', 'zx'):
        want = outs['interp-cpm'] if k == 'cpm' else outs['interp']
        if k == 'cpm' and outs[k] == want and 'Spectrum-only' in outs[k]:     # agreeing, but neither ran to the end
            print(f'  cpm: both stop the same way: {outs[k].strip().splitlines()[-1]}')
        elif outs[k] == want:
            print(f'  {k}: the same text' + (' (as the interpreter prints it --as cpm)' if k == 'cpm' and want != outs['interp'] else ''))
        elif k in ('cpm', 'zx') and floats_agree(outs[k], want):
            tolerated = True                    # PRINT-FP's 8 digits against the interpreter's 10
            print(f"  {k}: the same text, its floats to 1e-7 (printed as the ROM's PRINT-FP prints them, 8 digits)")
        elif k == 'cpm' and 'Spectrum-only' in outs[k]:
            print(f'  cpm: not run (the program uses the Spectrum outside if ZX)')
        else:
            ok = False
            print(f'  {k}: DIFFERENT text (exit {codes[k]}):')
            for line in outs[k].splitlines()[:5]:
                print(f'      {line}')
    iscr = os.path.join(work, 'interp.scr')
    if os.path.exists(iscr) and os.path.exists(zscr):
        a, b = open(iscr, 'rb').read(), open(zscr, 'rb').read()
        diff = [i for i in range(6912) if upper(i) and a[i] != b[i]]
        if diff:
            ok = False
            print(f'  screen: {len(diff)} bytes differ between the interpreter and the 48K, first at {0x4000 + diff[0]:04X}h'
                  + (' (floats printed on it have different digits)' if tolerated else ''))
        else:
            print('  screen: the interpreter\'s and the 48K\'s are the same (upper 22 rows)')
    return 0 if ok else 1


EXAMPLES = """examples:
  ./bly run examples/maze.bly                    in the interpreter
  ./bly all interp/tests/aoc2022d01.bly interp/tests/aoc2022d01.in
  ./bly tap examples/life.bly -o life.tap        a tape for a real Spectrum
  ./bly c -o life examples/life.bly              an executable to keep: ./life
  ./bly COMMAND -h                               more about one command
"""


def parser():
    ap = argparse.ArgumentParser(prog='bly', description=__doc__, epilog=EXAMPLES,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest='cmd', metavar='COMMAND', required=True)

    def command(name, help, description=None, inputs='?'):
        p = sub.add_parser(name, help=help, description=description or help[0].upper() + help[1:] + '.')
        p.add_argument('program', metavar='PROGRAM.bly', help='the program')
        p.add_argument('input', metavar='INPUT', nargs=inputs, help='its input: what lines(), grid() and input() read'
                       + ('; several, and the tape runs it on each in turn, loading the next when a run ends'
                          if inputs == '*' else ''))
        return p

    p = command('run', "run it in the interpreter, which is the language's specification")
    p.add_argument('--as', dest='target', choices=['zx48', 'cpm'], default='zx48',
                   help='the machine it is, as far as the program can tell (default zx48)')
    p.add_argument('--screen', metavar='OUT.png',
                   help="save the Spectrum's screen at the end as a picture (and OUT.scr beside it)")
    p.add_argument('--sound', metavar='OUT.txt', help='save a log of the notes it played')
    p = command('c', 'compile it to C, build that with the C compiler, and run it',
                "Compile it to C, build that with the C compiler (-O3, no sanitizers: the tests build theirs with "
                "them), and run it. With -o, keep the executable and don't run it, so it can be run, and timed, on "
                "its own: OUT [INPUT].")
    p.add_argument('-o', dest='out', metavar='OUT', help="keep the executable here, and don't run it")
    p.add_argument('--wrap', action='store_true',
                   help="integer overflow wraps round instead of stopping the program: a quarter to a third less time where "
                   "the arithmetic is the work, for a program already tested without it (indexes and division by "
                   "zero are still checked)")
    unchecked = ("8- and 16-bit indexes go unchecked: a quarter less time where indexing is the work, for a "
                 "program already proven with them checked (a wrong index then reads or writes wherever it points)")
    p = command('cpm', 'compile it for CP/M, assemble it, and run it under tnylpo')
    p.add_argument('--unchecked', action='store_true', help=unchecked)
    p = command('tap', 'make a tape for a 48K Spectrum (a real one, or any emulator)', inputs='*')
    p.add_argument('-o', dest='out', metavar='OUT.tap', help='where to put it (default build/bly/PROGRAM.tap)')
    p.add_argument('--unchecked', action='store_true', help=unchecked)
    p = command('zx', "make the tape and run it on omse-ai's 48K, printing what the program printed", inputs='*')
    p.add_argument('--unchecked', action='store_true', help=unchecked)
    p.add_argument('--scr', metavar='OUT.scr',
                   help="save the 48K's screen at the end (OUT.png: as a picture, its border the 48K's, and OUT.scr "
                   "beside it)")
    p.add_argument('--minutes', type=float, default=10, metavar='N',
                   help='give up after N minutes of Spectrum time (default 10)')
    p = command('all', 'run it all four ways and compare what each printed, and the final screens',
                "Run it in the interpreter, as C, under CP/M and on the 48K, and compare: the text each prints "
                "(CP/M's against the interpreter's --as cpm), and the interpreter's final screen against the "
                "48K's (the upper 22 rows).")
    p.add_argument('--minutes', type=float, default=10, metavar='N',
                   help='give up on the 48K after N minutes of Spectrum time (default 10)')
    return ap


def main(argv):
    a = parser().parse_args(argv)
    prog = a.program
    inp = [os.path.abspath(f) for f in (a.input if isinstance(a.input, list) else [a.input] if a.input else [])]
    for path in [prog] + inp:
        if not os.path.exists(path):
            sys.exit(f'bly: {path}: no such file')
    if a.cmd == 'run':
        opts = ['--as', a.target] + (['--screen', a.screen] if a.screen else []) + \
            (['--sound', a.sound] if a.sound else [])
        sys.exit(subprocess.run([sys.executable, os.path.join(ROOT, 'interp', 'barley.py')] + opts + [prog] + inp)
                 .returncode)
    stem = os.path.splitext(os.path.basename(prog))[0]
    work = tempfile.mkdtemp(prefix=stem + '-', dir=paths.build_dir('bly'))    # this run's own folder
    try:
        if a.cmd == 'c':
            if a.out and inp:
                sys.exit('bly c -o: the input goes to the executable when it runs (OUT INPUT), not to the build')
            code, msg = run_c(prog, inp, work, out=a.out, wrap=a.wrap)
            if a.out and not code:
                print(a.out)
            sys.exit(msg.rstrip() if code and msg else code)
        if a.cmd == 'cpm':
            code, msg = run_cpm(prog, inp, work, unchecked=a.unchecked)
            sys.exit(msg.rstrip() if code and msg else code)
        keys = typed_keys() if a.cmd in ('zx', 'all') and reads_keys(prog) else None     # tap never types
        if a.cmd == 'all':
            sys.exit(run_all(prog, inp, work, a.minutes, keys))
        tap = (a.out if a.cmd == 'tap' else None) or os.path.join(paths.build_dir('bly'), stem + '.tap')
        # tap's is a tape to keep, for a real Spectrum: plain, without the transcript's markers
        if make_tap(prog, inp, tap, plain=a.cmd == 'tap', unchecked=a.unchecked):
            sys.exit(1)
        if a.cmd == 'tap':
            print(tap)
            return
        code, _ = run_zx(tap, a.scr, a.minutes, keys=keys, wait_ask=bool(keys) and asks_only(prog))
        sys.exit(code)
    finally:
        shutil.rmtree(work, ignore_errors=True)


if __name__ == '__main__':
    main(sys.argv[1:])
