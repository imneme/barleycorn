-- Advent of Code 2024, day 14 (Restroom Redoubt), robots_d14+: Melissa O'Neill's ZX Spectrum BASIC and Z80, ported to
-- Barley by Puzzle Fern (robots_d14.bly), and made quick on a 48K by Speccy-Zone Fern. The same instrument: robots on
-- a floor 101 tiles wide and 103 tall, one pixel a tile, the time, and keys to step it by a second (X, Z) or by 101 or
-- 103 (Q and A, P and O). 0 stops. Melissa asked whether better Barley could make it snappy on a classic 48K: the
-- plain port takes 0.56 s a step there, nearly all of it in three loops (moving the robots, setting their bits in the
-- frame, sweeping the frame onto the screen), and better Barley code saves only about a tenth, because each array
-- access checks its index. So those loops are asm clauses here, as Barley allows (DESIGN.md, section 5): on the 48K
-- they run Z80 (robots_d14plus.asm), and everywhere else their Barley twins, which bly all holds the Z80 to. The
-- sweep takes her idea of a table of row addresses, walked with IX rather than her stack pointer, so interrupts
-- never matter. The Z80 trusts every robot to be on the floor, so main checks each one as it reads it.
-- Its input is robots_d14.txt: our own robots (make_robots.py), most of them a fern in a pot. Or Melissa's own floors,
-- robots_d14_floors/*.txt, all on one tape (bly tap with them all): solve one, press 0, and the next one loads.
const W = 101
const H = 103
const MOST = 600                           -- robots
const BIT = byte[128, 64, 32, 16, 8, 4, 2, 1]           -- a tile's bit in its byte of the frame

var px: byte[MOST]                         -- where each robot is
var py: byte[MOST]
var vx: byte[MOST]                         -- its velocity, as a step forward round the floor
var vy: byte[MOST]
var ax: byte[MOST]                         -- and what 103 seconds do to its column, and 101 to its row
var ay: byte[MOST]
var n = 0
var time = 0                               -- 0 to 10402: after 101 x 103 seconds every robot is back
var frame: byte[13 * H]                    -- her grid, packed eight tiles to a byte, a row 13 bytes wide
var row_at: word[H]                        -- her table: where each of the floor's rows starts on the screen
var typed = ""                             -- on CP/M, the keys typed, a line at a time
var next_typed = 0

func show_banner()                         -- her header: a band of PAPER 1, the title in yellow, between two bars
  paper(1); ink(7)
  for c in 0..32 do
    print at 0, c; "\x83";                -- the top half of a cell (print at: display, not output)
  end
  ink(6)
  print at 1, 0; " AoC 2024 D14: Restroom Redoubt ";
  ink(7)
  for c in 0..32 do
    print at 2, c; "\x8C";                -- and the bottom half
  end
end

func setup()
  if ZX then
    paper(7); ink(0); border(7); cls()
    show_banner()
    paper(0); ink(4); bright(true)         -- the floor: 13 cells square, black, for bright green robots
    for r in 5..18 do
      print at r, 1; "             ";
    end
    bright(false); paper(7); ink(0)
    line(7, 32, 7, 136); line(7, 136, 111, 136)          -- her frame: two pixels thick at the left and top,
    line(6, 32, 6, 137); line(6, 137, 111, 137)
    line(6, 31, 111, 31)                                  -- one at the bottom
    paper(5); ink(7)
    print at 5, 17; "\x83\x83\x83\x83\x83\x83\x83\x83\x83\x83\x83\x83\x83\x83\x83";
    ink(1)
    print at 6, 17; " Time: 0",
    ink(7)
    print at 7, 17; "\x8C\x8C\x8C\x8C\x8C\x8C\x8C\x8C\x8C\x8C\x8C\x8C\x8C\x8C\x8C";
    paper(7); ink(1)
    print at 9, 17; "Keys:";
    print at 10, 19; "X  + 1 sec";
    print at 11, 19; "Z  - 1 sec";
    print at 12, 19; "Q  + 101 sec";
    print at 13, 19; "A  - 101 sec";
    print at 14, 19; "P  + 103 sec";
    print at 15, 19; "O  - 103 sec";
    print at 16, 19; "0  Exit Sim";
    print at 20, 0; "Instructions:";
    print #0; at 0, 0; "Find an anomaly with X or Z";
    print #0; at 1, 0; "then use Q,A,O, or P to refine";
    for r in 22..24 do                     -- her INK 3 inside the PRINT #0: the lower screen keeps its own
      for c in 0..32 do attr(r, c, 7 * 8 + 3) end         -- colours, so they're set afterwards
    end
    for y in 0..H do                       -- pixel rows 40 to 142, from byte 1 (her indent)
      var r = 40 + y
      row_at[y] = word(0x4001 + ((r & 0xC0) << 5) + ((r & 7) << 8) + ((r & 0x38) << 2))
    end
  end
end

func show()                                -- her pos2grid and grid2screen, and the time
  if ZX then
    mark(px, py, frame, n)
    sweep(frame, row_at)
    paper(5); ink(1)
    print at 6, 24; time,
    paper(7); ink(0)
  end
end

func move_on(xs: byte[], vs: byte[], count: int, m: int)     -- each xs[i] steps vs[i] round a floor m wide
  for i in 0..count do
    var x = int(xs[i]) + int(vs[i])
    if x >= m then x -= m end
    xs[i] = byte(x)
  end
asm "robots_d14plus.asm"
end

func move_back(xs: byte[], vs: byte[], count: int, m: int)   -- and back
  for i in 0..count do
    var x = int(xs[i]) - int(vs[i])
    if x < 0 then x += m end
    xs[i] = byte(x)
  end
asm "robots_d14plus.asm"
end

func mark(xs: byte[], ys: byte[], tiles: byte[], count: int) -- her pos2grid: each robot's bit, 13 bytes a row
  for i in 0..count do
    var x = xs[i]
    var k = word(ys[i]) * 13 + (x >> 3)
    tiles[k] |= BIT[x & 7]
  end
asm "robots_d14plus.asm"
end

func sweep(tiles: byte[], rows: word[])                  -- her grid2screen: 13 bytes to each row, cleared after
  var k = 0
  for y in 0..int(rows.len) do
    for c in 0..13 do
      poke(rows[y] + word(c), tiles[k])
      tiles[k] = 0
      k += 1
    end
  end
asm "robots_d14plus.asm"
end

func advance(alt: bool, cols: bool, rows: bool)          -- her advance, with her patched ADD as two flags
  if cols then
    if alt then move_on(px, ax, n, W) else move_on(px, vx, n, W) end
  end
  if rows then
    if alt then move_on(py, ay, n, H) else move_on(py, vy, n, H) end
  end
end

func retreat(alt: bool, cols: bool, rows: bool)          -- and back
  if cols then
    if alt then move_back(px, ax, n, W) else move_back(px, vx, n, W) end
  end
  if rows then
    if alt then move_back(py, ay, n, H) else move_back(py, vy, n, H) end
  end
end

func adjust(by: int)                       -- the time, round 101 x 103
  time = mod(time + by, W * H)
end

func next_key(): byte                      -- a key pressed (on CP/M, the next one typed)
  var k: byte = 0
  if CPM then
    while next_typed >= int(typed.len) do
      typed = ask("")
      next_typed = 0
    end
    k = typed[next_typed]
    next_typed += 1
  else
    while k == 0 do k = key() end
  end
  return k
end

func main()
  for line in lines() do                   -- p=x,y v=dx,dy, and the steps her Perl worked out
    px[n] = line.int(0); py[n] = line.int(1)
    assert px[n] < W and py[n] < H                       -- on the floor: the Z80 trusts that it is
    var dx: int = line.int(2)
    var dy: int = line.int(3)
    vx[n] = byte(mod(dx, W)); vy[n] = byte(mod(dy, H))
    ax[n] = byte(mod(dx * H, W)); ay[n] = byte(mod(dy * W, H))
    n += 1
  end
  setup()
  show()
  while true do
    case next_key()
      when 'x' then adjust(1); advance(false, true, true)
      when 'z' then adjust(-1); retreat(false, true, true)
      when 'q' then adjust(W); advance(true, false, true)
      when 'a' then adjust(-W); retreat(true, false, true)
      when 'p' then adjust(H); advance(true, true, false)
      when 'o' then adjust(-H); retreat(true, true, false)
      when '0' then break
      else continue
    end
    show()
  end
  if ZX then
    paper(7); ink(0)
    print at 20, 0; "                                ";
    print at 20, 0;
  end
  print "Time: "; time
end

-- keys:
-- < aaaaaaaoooooooooooooooooooooooooooooooooooooo0
