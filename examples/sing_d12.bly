-- AoC 2022 day 12, made to sing: the search spreads down from the summit, leaving a contour every five steps,
-- and the speaker climbs a semitone every dozen. (The design's "making it sing", section 8.)

func height(ch: byte): byte
  case ch
    when 'S' then return 'a'
    when 'E' then return 'z'
  end
  return ch
end

func main()
  var g = grid()
  var start = g.find('S')
  var goal = g.find('E')
  var dist = grid[byte](g.rows, g.cols, 255)        -- bytes, not words: a 48K has room for these
  var q = queue[pos](220)
  border(0)
  paper(0)
  ink(4)
  bright(true)
  cls()
  dist[goal] = 0
  q.put(goal)
  var part2: byte = 255
  var layer: byte = 0
  while q.len > 0 do
    var p = q.get()
    if dist[p] % 5 == 0 then
      plot(p.c + 47, 160 - p.r * 3)
      plot(p.c + 47, 159 - p.r * 3)
      plot(p.c + 47, 158 - p.r * 3)
    end
    if dist[p] > layer then
      layer = dist[p]
      if layer % 12 == 0 then beep(15, int(layer / 12) - 12) end
    end
    if height(g[p]) == 'a' then part2 = min(part2, dist[p]) end
    for d in dirs4 do
      var n = p + d
      if g.has(n) and dist[n] == 255 and height(g[n]) + 1 >= height(g[p]) then
        dist[n] = dist[p] + 1
        q.put(n)
      end
    end
  end
  ink(2)
  circle(goal.c + 47, 159 - goal.r * 3, 4)
  ink(5)
  circle(start.c + 47, 159 - start.r * 3, 4)
  ink(6)
  print at 20, 1; "Part 1: "; dist[start]; "   Part 2: "; part2
end
