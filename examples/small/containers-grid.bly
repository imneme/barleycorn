-- grid() is the input as rows and columns: g[p] reads a square, find() looks for one, has() knows the edge, dirs8 goes round.

func main()
  var g = grid()                           -- a minefield, in place in the input: * for a mine, . for clear ground
  var first = g.find('*')                  -- find() reads across each row, top to bottom
  print g.rows; " rows of "; g.cols; ", and the first mine is at "; first
  var mines = 0
  for r in 0..g.rows do
    for c in 0..g.cols do
      var p = pos(r, c)
      if g[p] == '*' then
        print "*";
        mines += 1
      else
        var n = 0
        for d in dirs8 do                  -- the eight around p, where they're on the field: has() is the edge test
          if g.has(p + d) and g[p + d] == '*' then n += 1 end
        end
        if n == 0 then print "."; else print n; end
      end
    end
    print
  end
  print mines; " mines"
end

-- input: containers-grid.txt

-- prints:
-- > 6 rows of 10, and the first mine is at (0, 6)
-- > .....1*1..
-- > .111.1221.
-- > .1*1123*1.
-- > 12211**21.
-- > 1*1.123221
-- > 111...1*2*
-- > 8 mines
