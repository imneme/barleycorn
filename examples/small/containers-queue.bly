-- queue[T](cap): put() at the back, get() from the front, which makes a breadth-first search: the shortest way out.

func main()
  var g = grid()                           -- the maze, from the input: # is wall, S the start, E the way out
  var start = g.find('S')
  var dist = grid[int](g.rows, g.cols, -1) -- how many steps from S, or -1 for not reached yet
  var q = queue[pos](g.rows * g.cols)
  dist[start] = 0
  q.put(start)
  while q.len > 0 do                       -- the nearest square still waiting, so the search spreads out in rings
    var p = q.get()
    for d in dirs4 do                      -- north, east, south and west
      var n = p + d
      if g.has(n) and g[n] != '#' and dist[n] < 0 then
        dist[n] = dist[p] + 1
        q.put(n)
      end
    end
  end
  for r in 0..g.rows do                    -- each square's distance, its last digit, so the rings show
    for c in 0..g.cols do
      if dist[r, c] < 0 then print chr(g[r, c]); else print dist[r, c] % 10; end
    end
    print
  end
  print "S to E: "; dist[g.find('E')]; " steps"
end

-- input: containers-queue.txt

-- prints:
-- > ###############
-- > #01234#0123456#
-- > #1###5#9#####7#
-- > #234#678#234#8#
-- > ###5#####1#3#9#
-- > #876#67890#210#
-- > #9###5#######1#
-- > #01234#8765432#
-- > ###############
-- > S to E: 22 steps
