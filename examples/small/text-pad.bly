-- Right-aligning a number without field widths: count the characters it prints as, then print a slice of spaces.

const SPACES = "           "               -- eleven: enough for any long, sign and all
const SUMS = long[5, 42, 1999, -7, 30000, 1000000]

func width(n: long): int                   -- how many characters print n makes
  var w = 1
  if n < 0 then w = 2 end                  -- one for the minus
  while n >= 10 or n <= -10 do n /= 10; w += 1 end       -- one more for each digit past the first
  return w
end

func right(n: long, w: int)                -- n, ending at column w, as Pascal's Write(n:w) and C's %*ld do
  print SPACES[0..max(w - width(n), 0)]; n;
end

func main()
  var total: long = 0
  for s in SUMS do
    right(s, 9); print
    total += s
  end
  print "---------"
  right(total, 9); print
end

-- prints:
-- >         5
-- >        42
-- >      1999
-- >        -7
-- >     30000
-- >   1000000
-- > ---------
-- >   1032039
