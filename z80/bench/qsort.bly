-- (phase one's benchmark suite, in today's Barley: HISTORY.md) Quicksort (Wirth's, middle pivot) of 400 pseudo-random words.
-- It recurses into the smaller half and loops on the larger.

const N = 400
var a: word[N]

func qsort(lo: int, hi: int)
  while lo < hi do
    var p = a[(lo + hi) / 2]
    var i = lo
    var j = hi
    while i <= j do
      while a[i] < p do i = i + 1 end
      while a[j] > p do j = j - 1 end
      if i <= j then
        var t = a[i]
        a[i] = a[j]
        a[j] = t
        i = i + 1
        j = j - 1
      end
    end
    if j - lo < hi - i then
      qsort(lo, j)
      lo = i
    else
      qsort(i, hi)
      hi = j
    end
  end
end

func main()
  var x: word = 4321
  for i in word(0)..N do
    x = x * 25173 + 13849
    a[i] = x
  end
  qsort(0, N - 1)
  var bad: word = 0
  var s: word = 0
  for i in word(0)..N do
    if i > 0 and a[i - 1] > a[i] then bad = bad + 1 end
    s = s * 31 + a[i]
  end
  print bad
  print s
end
