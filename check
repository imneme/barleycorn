#!/usr/bin/env python3
"""Run every test Barley has, in order, and say what passed.

A stage whose tools aren't here is skipped, with a note saying what it needs
(paths.py says where each tool is looked for).
"""
import argparse
import os
import shutil
import subprocess
import sys
import time

ROOT = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, ROOT)
import paths                                                    # noqa: E402

PY = sys.executable
OPY = paths.OMSE_AI_PYTHON


def have(tool):
    return bool(os.path.exists(tool) or shutil.which(tool))


def omse_ready():
    return os.path.isdir(paths.OMSE_AI) and os.path.exists(os.path.join(paths.OMSE_AI_ROMS, '48.rom'))


SUITE = os.path.join(ROOT, 'interp', 'tests', 'run.py')
FRAG = ['test_core', 'test_gen', 'test_int', 'test_num', 'test_text', 'test_containers', 'test_zxgfx', 'test_fp',
        'test_random', 'test_peephole']


def stages(quick):
    return [
        ('interp', 'the suite in the interpreter (the spec)', lambda: None, [[PY, SUITE]]),
        ('c', 'the suite as C, with the sanitizers', lambda: None if have(paths.CC) else f'needs a C compiler ({paths.CC})',
         [[PY, SUITE, '--c']]),
        ('cpm', 'the suite as CP/M programs under tnylpo',
         lambda: None if have(paths.SJASMPLUS) and have(paths.TNYLPO) else 'needs sjasmplus and tnylpo',
         [[PY, SUITE, '--z80']]),
        ('zx', 'the suite on the 48K Spectrum (omse-ai)',
         lambda: None if have(paths.SJASMPLUS) and omse_ready() else 'needs sjasmplus, omse-ai and the 48K ROM',
         [[PY, SUITE, '--zx']]),
        ('fragments', "each library fragment against its Python model, on a bare Z80",
         lambda: None if have(paths.SJASMPLUS) and omse_ready() else 'needs sjasmplus, omse-ai and the 48K ROM',
         [[OPY, os.path.join(ROOT, 'z80', 'tests', t + '.py')] + (['--quick'] if quick and t not in ('test_core', 'test_gen', 'test_int') else [])
          for t in FRAG] + ([] if quick else [[OPY, os.path.join(ROOT, 'z80', 'tests', 'test_int_mutants.py')],
                                               [OPY, os.path.join(ROOT, 'z80', 'tests', 'test_fp_mutants.py')],
                                               [OPY, os.path.join(ROOT, 'z80', 'tests', 'test_random.py'), '--mutants'],
                                               [OPY, os.path.join(ROOT, 'z80', 'tests', 'rom_text_check.py')],
                                               [OPY, os.path.join(ROOT, 'z80', 'tests', 'co_temp_check.py')],
                                               [OPY, os.path.join(ROOT, 'z80', 'tests', 'ula_check.py')],
                                               [OPY, os.path.join(ROOT, 'z80', 'tests', 'lower_check.py')],
                                               [OPY, os.path.join(ROOT, 'z80', 'tests', 'fzx_check.py')]])),
        ('screen', 'the C screen against the reference', lambda: None if have(paths.CC) and omse_ready() else
         'needs a C compiler and the 48K ROM', [[PY, os.path.join(ROOT, 'c', 'tests', 'test_screen.py')]]),
        ('small', 'the small examples print what they say, on every machine',
         lambda: None if have(paths.CC) and have(paths.SJASMPLUS) and have(paths.TNYLPO) and omse_ready() else
         'needs a C compiler, sjasmplus, tnylpo, omse-ai and the 48K ROM',
         [[PY, os.path.join(ROOT, 'tools', 'check_small.py')]]),
        ('docs', 'the programs the docs quote are the programs as they are', lambda: None,
         [[PY, os.path.join(ROOT, 'tools', 'check_docs.py')]]),
        ('wrap', 'the Markdown wrapped at 72 columns, as mdwrap does it',
         lambda: None if have(paths.MDWRAP) else 'needs mdwrap (MDWRAP in paths.py)',
         [[PY, os.path.join(ROOT, 'tools', 'check_docs.py'), '--wrap', paths.MDWRAP]]),
        ('fuzz', 'random programs: the interpreter against C and CP/M',
         lambda: None if have(paths.CC) and have(paths.SJASMPLUS) and have(paths.TNYLPO) else 'needs a C compiler, sjasmplus and tnylpo',
         [[PY, os.path.join(ROOT, 'z80', 'fuzz.py'), '100' if quick else '400']]),
    ]


ap = argparse.ArgumentParser(prog='check', description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter,
                             epilog='stages:\n' + '\n'.join(f'  {name:10} {what}' for name, what, _, _ in stages(False)))
ap.add_argument('stages', nargs='*', metavar='STAGE', help='only these stages (default: every one)')
ap.add_argument('--quick', action='store_true',
                help="skip the slow parts: the fuzzer, and most of the fragments' random cases")
args = ap.parse_args()
STAGES = stages(args.quick)
unknown = [a for a in args.stages if a not in [st[0] for st in STAGES]]
if unknown:
    ap.error(f'no stage called {", ".join(unknown)} (see check -h)')
only = args.stages
if args.quick:
    STAGES = [s for s in STAGES if s[0] not in ('fuzz',)]

failed = []
for name, what, missing, cmds in STAGES:
    if only and name not in only:
        continue
    why = missing()
    if why:
        print(f'skip  {name:10} {what}: {why}')
        continue
    t0 = time.time()
    ok = True
    for cmd in cmds:
        r = subprocess.run(cmd, capture_output=True, text=True, encoding='latin-1', cwd=ROOT)
        last = (r.stdout.strip().splitlines() or [''])[-1]
        bad = r.returncode != 0 or ' FAIL' in r.stdout or 'FAIL:' in r.stdout or 'Traceback' in r.stderr
        if bad:
            ok = False
            print(f'FAIL  {name:10} {os.path.basename(cmd[-1] if not cmd[-1].isdigit() else cmd[-2])}: {last}')
            print('      ' + '\n      '.join((r.stdout + r.stderr).strip().splitlines()[-12:]))
    print(f'{"ok  " if ok else "FAIL"}  {name:10} {what} ({time.time() - t0:.0f} s)')
    if not ok:
        failed.append(name)
print('all passed' if not failed else f'failed: {", ".join(failed)}')
sys.exit(1 if failed else 0)
